<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Desires — Intimacy, Refined</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&family=Jost:wght@300;400;500&display=swap');

  :root {
    --noir:  #1c1418;
    --plum:  #4a1c35;
    --mauve: #9b5e72;
    --blush: #e8cdd4;
    --petal: #f5eaed;
    --linen: #faf6f4;
    --warm:  #c8a882;
    --mist:  #8a7880;
    --gold:  #b8965a;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'Jost', sans-serif; background: var(--linen); color: var(--noir); font-weight: 300; line-height: 1.65; font-size: 15px; }

  /* AGE GATE */
  #ageGate { position: fixed; inset: 0; z-index: 1000; background: var(--noir); display: flex; align-items: center; justify-content: center; }
  #ageGate.gone { display: none; }
  .gate-inner { max-width: 420px; width: 90%; text-align: center; padding: 3.5rem 2.5rem; border: 1px solid rgba(232,205,212,.15); border-radius: 2px; }
  .gate-wordmark { font-family: 'Playfair Display', serif; font-size: 2.8rem; font-style: italic; color: var(--blush); letter-spacing: .06em; margin-bottom: .25rem; }
  .gate-sub { font-size: .7rem; letter-spacing: .22em; text-transform: uppercase; color: var(--mauve); margin-bottom: 2rem; display: block; }
  .gate-q { font-family: 'Playfair Display', serif; font-size: 1.5rem; color: var(--linen); margin-bottom: .7rem; }
  .gate-note { font-size: .8rem; color: var(--mist); margin-bottom: 2rem; line-height: 1.7; }
  .gate-btns { display: flex; gap: .8rem; justify-content: center; }
  .g-enter { background: var(--plum); color: #fff; border: none; padding: .7rem 2.2rem; font-family: 'Jost', sans-serif; font-size: .82rem; letter-spacing: .1em; text-transform: uppercase; border-radius: 1px; cursor: pointer; transition: background .2s; }
  .g-enter:hover { background: var(--mauve); }
  .g-leave { background: transparent; color: var(--mist); border: 1px solid rgba(138,120,128,.35); padding: .7rem 2.2rem; font-family: 'Jost', sans-serif; font-size: .82rem; letter-spacing: .1em; text-transform: uppercase; border-radius: 1px; cursor: pointer; }

  /* NAV */
  nav { position: sticky; top: 0; z-index: 100; background: rgba(250,246,244,.97); backdrop-filter: blur(12px); border-bottom: 1px solid var(--blush); display: flex; align-items: center; justify-content: space-between; padding: 0 3rem; height: 68px; }
  .wordmark { font-family: 'Playfair Display', serif; font-size: 1.7rem; font-style: italic; color: var(--plum); text-decoration: none; }
  .nav-links { display: flex; gap: 2.4rem; list-style: none; }
  .nav-links a { font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; color: var(--mist); text-decoration: none; transition: color .2s; }
  .nav-links a:hover { color: var(--plum); }
  .cart-pill { background: var(--plum); color: #fff; border: none; padding: .45rem 1.2rem; border-radius: 30px; font-family: 'Jost', sans-serif; font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; transition: background .2s; }
  .cart-pill:hover { background: var(--mauve); }

  /* HERO */
  .hero { display: grid; grid-template-columns: 55% 45%; min-height: 88vh; }
  .hero-left {
    background: linear-gradient(135deg, #2a0a1e 0%, #4a1c35 50%, #1c0d16 100%);
    position: relative; overflow: hidden;
    display: flex; align-items: flex-end; padding: 3.5rem;
  }
  .hero-bg-art {
    position: absolute; inset: 0; opacity: .18;
    background-image: radial-gradient(ellipse at 30% 60%, #9b5e72 0%, transparent 60%),
                      radial-gradient(ellipse at 80% 20%, #c8a882 0%, transparent 50%);
  }
  /* Decorative rose SVG in hero */
  .hero-rose {
    position: absolute; top: 10%; right: 8%; opacity: .22; width: 260px; height: 260px;
  }
  .hero-copy { position: relative; z-index: 1; }
  .eyebrow { font-size: .68rem; letter-spacing: .22em; text-transform: uppercase; color: var(--warm); margin-bottom: 1rem; }
  .hero-h1 { font-family: 'Playfair Display', serif; font-size: clamp(2.6rem,4.5vw,4.4rem); font-weight: 400; line-height: 1.08; color: #fff; margin-bottom: 1.1rem; }
  .hero-h1 em { font-style: italic; color: var(--blush); }
  .hero-p { font-size: .9rem; color: rgba(255,255,255,.68); max-width: 380px; line-height: 1.8; margin-bottom: 2rem; }
  .hero-btns { display: flex; gap: .9rem; flex-wrap: wrap; }
  .btn-solid { background: var(--plum); color: #fff; border: none; padding: .75rem 2rem; border-radius: 1px; font-family: 'Jost', sans-serif; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; transition: background .2s; }
  .btn-solid:hover { background: var(--mauve); }
  .btn-ghost { background: transparent; color: rgba(255,255,255,.85); border: 1px solid rgba(255,255,255,.4); padding: .75rem 2rem; border-radius: 1px; font-family: 'Jost', sans-serif; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; }
  .btn-ghost:hover { border-color: #fff; color: #fff; }

  .hero-right { background: var(--petal); display: flex; flex-direction: column; justify-content: center; padding: 4rem 3.5rem; gap: 1.8rem; }
  .feat-label { font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: var(--mauve); }
  .feat-title { font-family: 'Playfair Display', serif; font-size: 1.9rem; color: var(--plum); line-height: 1.2; }
  .feat-card { background: #fff; border-radius: 3px; overflow: hidden; box-shadow: 0 4px 24px rgba(74,28,53,.1); display: flex; }
  .feat-thumb { width: 130px; height: 130px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
  .fc-body { padding: 1.1rem 1.2rem; display: flex; flex-direction: column; justify-content: center; }
  .fc-brand { font-size: .67rem; letter-spacing: .14em; text-transform: uppercase; color: var(--mauve); margin-bottom: .25rem; }
  .fc-name { font-family: 'Playfair Display', serif; font-size: 1.1rem; color: var(--plum); margin-bottom: .3rem; }
  .fc-desc { font-size: .78rem; color: var(--mist); line-height: 1.6; margin-bottom: .6rem; }
  .fc-price { font-size: 1rem; font-weight: 500; color: var(--plum); }
  .pay-row { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; padding-top: .6rem; border-top: 1px solid var(--blush); }
  .pay-lbl { font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--mist); }
  .chip { font-size: .72rem; padding: .22rem .65rem; border-radius: 20px; }
  .chip.pp { background: #003087; color: #fff; }
  .chip.ap { background: #111; color: #fff; }
  .chip.cc { background: var(--blush); color: var(--plum); }

  /* TRUST */
  .trust { background: var(--plum); color: var(--blush); display: flex; justify-content: center; gap: 3.5rem; padding: .9rem 2rem; flex-wrap: wrap; }
  .trust-i { display: flex; align-items: center; gap: .55rem; font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; }

  /* SECTIONS */
  .sec { padding: 5rem 3.5rem; }
  .sec-hd { margin-bottom: 2.8rem; }
  .sec-eye { font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: var(--mauve); margin-bottom: .6rem; }
  .sec-title { font-family: 'Playfair Display', serif; font-size: 2.2rem; font-weight: 400; color: var(--plum); }

  /* CATEGORIES */
  .cat-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 1rem; }
  .cat-card { position: relative; overflow: hidden; border-radius: 3px; aspect-ratio: 2/3; cursor: pointer; transition: transform .3s; }
  .cat-card:hover { transform: translateY(-4px); }
  .cat-visual { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 4rem; }
  .cat-veil { position: absolute; inset: 0; background: linear-gradient(to top,rgba(28,20,24,.85),rgba(28,20,24,.05) 65%); display: flex; flex-direction: column; justify-content: flex-end; padding: 1.4rem; }
  .cat-name { font-family: 'Playfair Display', serif; color: #fff; font-size: 1.2rem; margin-bottom: .25rem; }
  .cat-ct { font-size: .73rem; color: rgba(232,205,212,.75); letter-spacing: .06em; }

  /* PRODUCTS */
  .products-bg { background: var(--petal); }
  .prod-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.6rem; }
  .prod-card { background: #fff; border-radius: 3px; overflow: hidden; cursor: pointer; transition: box-shadow .25s, transform .25s; }
  .prod-card:hover { box-shadow: 0 10px 40px rgba(74,28,53,.13); transform: translateY(-3px); }
  .prod-thumb { position: relative; aspect-ratio: 1/1; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .prod-flag { position: absolute; top: .8rem; left: .8rem; background: var(--plum); color: #fff; font-size: .63rem; letter-spacing: .1em; text-transform: uppercase; padding: .25rem .65rem; border-radius: 1px; z-index: 1; }
  .prod-flag.sale { background: var(--gold); }
  .prod-flag.new-tag { background: #2d6b3e; }
  .prod-body { padding: 1.25rem; }
  .prod-brand { font-size: .67rem; letter-spacing: .14em; text-transform: uppercase; color: var(--mauve); margin-bottom: .25rem; }
  .prod-name { font-family: 'Playfair Display', serif; font-size: 1.1rem; color: var(--plum); margin-bottom: .4rem; }
  .prod-desc { font-size: .8rem; color: var(--mist); line-height: 1.65; margin-bottom: .9rem; }
  .prod-foot { display: flex; justify-content: space-between; align-items: center; }
  .prod-price { font-size: 1rem; font-weight: 500; color: var(--plum); }
  .stars { color: var(--gold); font-size: .78rem; margin-bottom: .3rem; }
  .add-icon { width: 34px; height: 34px; border-radius: 50%; background: var(--plum); color: #fff; border: none; font-size: 1.1rem; cursor: pointer; transition: background .2s; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .add-icon:hover { background: var(--mauve); }
  .color-dots { display: flex; gap: .4rem; margin-bottom: .7rem; flex-wrap: wrap; }
  .cdot { width: 16px; height: 16px; border-radius: 50%; border: 1.5px solid rgba(0,0,0,.15); display: inline-block; cursor: pointer; transition: transform .15s; flex-shrink: 0; }
  .cdot:hover { transform: scale(1.3); }

  /* PHOTO UPLOAD NOTICE */
  .photo-notice { background: #fff8e1; border: 1px dashed var(--gold); border-radius: 3px; padding: .6rem 1rem; font-size: .75rem; color: #7a5c1e; margin-bottom: 1.5rem; display: flex; align-items: center; gap: .5rem; }

  /* PERSONAL NOTE */
  .personal-sec { display: grid; grid-template-columns: 1fr 1fr; }
  .personal-visual { background: linear-gradient(135deg,#2a0a1e,#4a1c35,#7a2d52); display: flex; align-items: center; justify-content: center; min-height: 500px; padding: 3rem; }
  .personal-copy { background: var(--plum); color: var(--blush); padding: 5rem 4rem; display: flex; flex-direction: column; justify-content: center; }
  .personal-copy .sec-eye { color: var(--warm); }
  .personal-copy .sec-title { color: var(--linen); margin-bottom: 1.4rem; font-size: 2rem; }
  .letter { font-size: .9rem; line-height: 1.85; color: rgba(232,205,212,.85); font-style: italic; border-left: 2px solid var(--mauve); padding-left: 1.2rem; margin-bottom: 1.6rem; }
  .sign { font-family: 'Playfair Display', serif; font-size: 1.2rem; font-style: italic; color: var(--warm); }
  .promise-cards { display: flex; flex-direction: column; gap: 1rem; margin-top: 2rem; }
  .pcard { background: rgba(255,255,255,.07); border-radius: 3px; padding: 1rem 1.2rem; display: flex; gap: 1rem; align-items: flex-start; border: 1px solid rgba(232,205,212,.1); }
  .pcard-icon { font-size: 1.3rem; flex-shrink: 0; }
  .pcard-title { font-family: 'Playfair Display', serif; font-size: 1rem; color: var(--linen); margin-bottom: .2rem; }
  .pcard-text { font-size: .78rem; color: rgba(232,205,212,.7); line-height: 1.6; }

  /* PAYMENT */
  .pay-sec { background: var(--noir); padding: 4rem 3.5rem; text-align: center; }
  .pay-sec .sec-eye { color: var(--mauve); }
  .pay-sec .sec-title { color: var(--linen); margin-bottom: .7rem; }
  .pay-sub { font-size: .88rem; color: var(--mist); max-width: 480px; margin: 0 auto 2.5rem; }
  .pay-methods { display: flex; justify-content: center; gap: 1.2rem; flex-wrap: wrap; }
  .pm { background: rgba(255,255,255,.05); border: 1px solid rgba(232,205,212,.12); border-radius: 3px; padding: 1.4rem 2rem; display: flex; flex-direction: column; align-items: center; gap: .5rem; min-width: 130px; }
  .pm-icon { font-size: 2rem; }
  .pm-name { font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; color: var(--blush); }
  .pm-note { font-size: .7rem; color: var(--mist); }
  .wix-line { font-size: .76rem; color: var(--mist); margin-top: 2rem; }
  .wix-line a { color: var(--mauve); text-decoration: none; }

  /* NEWSLETTER */
  .nl-sec { background: var(--petal); text-align: center; padding: 4.5rem 3.5rem; }
  .nl-sec .sec-title { color: var(--plum); margin-bottom: .8rem; }
  .nl-sub { font-size: .88rem; color: var(--mist); max-width: 420px; margin: 0 auto 2rem; line-height: 1.75; }
  .nl-form { display: flex; gap: .6rem; max-width: 400px; margin: 0 auto; }
  .nl-input { flex: 1; padding: .72rem 1rem; border: 1px solid var(--blush); border-radius: 1px; background: #fff; font-family: 'Jost', sans-serif; font-size: .85rem; color: var(--noir); outline: none; }
  .nl-input:focus { border-color: var(--mauve); }

  /* FOOTER */
  footer { background: var(--noir); padding: 3.5rem; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 3rem; border-top: 1px solid rgba(232,205,212,.08); }
  .f-logo { font-family: 'Playfair Display', serif; font-size: 1.9rem; font-style: italic; color: var(--blush); display: block; margin-bottom: .75rem; }
  .f-tag { font-size: .8rem; color: var(--mist); line-height: 1.75; max-width: 220px; }
  .f-col h4 { font-size: .68rem; letter-spacing: .18em; text-transform: uppercase; color: var(--mauve); margin-bottom: 1rem; }
  .f-col ul { list-style: none; display: flex; flex-direction: column; gap: .5rem; }
  .f-col ul a { font-size: .8rem; color: var(--mist); text-decoration: none; transition: color .2s; }
  .f-col ul a:hover { color: var(--blush); }
  .f-bottom { background: var(--noir); border-top: 1px solid rgba(232,205,212,.07); padding: 1.1rem 3.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: .5rem; }
  .f-bottom p { font-size: .73rem; color: var(--mist); }

  /* MODAL */
  .modal-bg { display: none; position: fixed; inset: 0; z-index: 200; background: rgba(28,20,24,.78); backdrop-filter: blur(5px); align-items: center; justify-content: center; }
  .modal-bg.open { display: flex; }
  .modal-box { background: var(--linen); border-radius: 3px; max-width: 560px; width: 92%; position: relative; display: flex; overflow: hidden; animation: slideUp .28s ease; }
  @keyframes slideUp { from{opacity:0;transform:translateY(22px)} to{opacity:1;transform:translateY(0)} }
  .modal-img-wrap { width: 210px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; padding: 1rem; }
  .modal-info { padding: 2rem 1.8rem; display: flex; flex-direction: column; justify-content: center; overflow-y: auto; max-height: 80vh; }
  .modal-brand { font-size: .67rem; letter-spacing: .14em; text-transform: uppercase; color: var(--mauve); margin-bottom: .3rem; }
  .modal-name { font-family: 'Playfair Display', serif; font-size: 1.45rem; color: var(--plum); margin-bottom: .5rem; }
  .modal-colors-row { margin-bottom: .8rem; }
  .modal-colors-row span { font-size: .75rem; color: var(--mist); margin-bottom: .4rem; display: block; }
  .modal-desc { font-size: .83rem; color: var(--mist); line-height: 1.7; margin-bottom: 1rem; }
  .modal-price { font-size: 1.2rem; font-weight: 500; color: var(--plum); margin-bottom: .5rem; }
  .modal-pay { font-size: .73rem; color: var(--mist); margin-bottom: 1.3rem; }
  .modal-actions { display: flex; gap: .7rem; }
  .btn-close { position: absolute; top: .9rem; right: .9rem; background: none; border: none; font-size: 1.2rem; cursor: pointer; color: var(--mist); }
  .btn-add { background: var(--plum); color: #fff; border: none; padding: .65rem 1.6rem; border-radius: 1px; font-family: 'Jost', sans-serif; font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; cursor: pointer; transition: background .2s; }
  .btn-add:hover { background: var(--mauve); }
  .btn-back { background: transparent; color: var(--plum); border: 1px solid var(--blush); padding: .65rem 1.2rem; border-radius: 1px; font-family: 'Jost', sans-serif; font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; cursor: pointer; }

  #toast { position: fixed; bottom: 2rem; right: 2rem; z-index: 500; background: var(--plum); color: #fff; padding: .9rem 1.6rem; border-radius: 2px; font-size: .85rem; box-shadow: 0 8px 30px rgba(0,0,0,.25); transform: translateY(70px); opacity: 0; transition: all .3s ease; }
  #toast.show { transform: translateY(0); opacity: 1; }

  @media(max-width:960px){
    .hero{grid-template-columns:1fr} .personal-sec{grid-template-columns:1fr} .personal-visual{min-height:220px}
    .prod-grid{grid-template-columns:repeat(2,1fr)} .cat-row{grid-template-columns:repeat(2,1fr)}
    footer{grid-template-columns:1fr 1fr;gap:2rem} .sec{padding:3rem 1.5rem}
    .hero-right,.personal-copy{padding:2.5rem 1.5rem} nav{padding:0 1.5rem} .nav-links{display:none}
    .trust{gap:1.2rem} footer,.f-bottom{padding:2.5rem 1.5rem}
    .modal-box{flex-direction:column} .modal-img-wrap{width:100%;height:180px}
  }
</style>
</head>
